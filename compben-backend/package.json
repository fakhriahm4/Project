{
  "name": "compben-backend",
  "version": "1.0.0",
  "description": "CompBen Platform - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node scripts/run-sql.js migrations/001_init.sql && node scripts/run-sql.js migrations/002_companies.sql && node scripts/run-sql.js migrations/003_user_profiles.sql && node scripts/run-sql.js migrations/004_must_change_password.sql && node scripts/run-sql.js migrations/005_settings.sql && node scripts/run-sql.js migrations/006_approval_notifications.sql && node scripts/run-sql.js migrations/007_cb_masters.sql && node scripts/run-sql.js migrations/008_user_employee_sync.sql && node scripts/run-sql.js migrations/009_payroll_eligibility.sql && node scripts/run-sql.js migrations/011_payroll_periods.sql",
    "db:seed": "node scripts/run-sql.js seeds/001_seed.sql && node scripts/run-sql.js seeds/002_companies.sql",
    "db:init": "pnpm db:migrate && pnpm db:seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "compben",
    "payroll",
    "hr"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "numeral": "^2.0.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "uuid": "^14.0.2",
    "winston": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/numeral": "^2.0.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2"
  }
}